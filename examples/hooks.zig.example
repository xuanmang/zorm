//! 查询钩子示例
//!
//! 本示例演示 ZORM 的查询钩子系统:
//! 1. 内置 Logging Hook
//! 2. 内置 Performance Hook
//! 3. 自定义钩子实现
//! 4. 多个钩子组合
//! 5. 钩子链执行顺序
//!
//! 运行方式:
//! ```sh
//! zig build run-example-hooks
//! ```

const std = @import("std");
const zorm = @import("zorm");

const User = struct {
    id: i64 = 0,
    name: []const u8,
    email: []const u8,
    pub const table_name = "users";
};

pub fn main() !void {
    var gpa = std.heap.GeneralPurposeAllocator(.{}){};
    defer _ = gpa.deinit();
    const allocator = gpa.allocator();

    std.debug.print("\n" ++ "=" ** 60 ++ "\n", .{});
    std.debug.print("ZORM 查询钩子示例\n", .{});
    std.debug.print("=" ** 60 ++ "\n\n", .{});

    try demonstrateHooks(allocator);

    std.debug.print("\n✅ 示例执行完成!\n", .{});
}

fn demonstrateHooks(allocator: std.mem.Allocator) !void {
    std.debug.print("📝 演示查询钩子系统:\n\n", .{});

    // ========================================
    // 1. Logging Hook
    // ========================================
    std.debug.print("1️⃣  Logging Hook - 记录查询日志\n", .{});
    demonstrateLoggingHook();

    // ========================================
    // 2. Performance Hook
    // ========================================
    std.debug.print("\n2️⃣  Performance Hook - 性能监控\n", .{});
    demonstratePerformanceHook();

    // ========================================
    // 3. 自定义钩子 - 查询统计
    // ========================================
    std.debug.print("\n3️⃣  自定义钩子 - 查询统计\n", .{});
    demonstrateCustomHook(allocator);

    // ========================================
    // 4. 自定义钩子 - 审计日志
    // ========================================
    std.debug.print("\n4️⃣  自定义钩子 - 审计日志\n", .{});
    demonstrateAuditHook();

    // ========================================
    // 5. 多个钩子组合
    // ========================================
    std.debug.print("\n5️⃣  多个钩子组合使用\n", .{});
    demonstrateMultipleHooks();
}

/// 演示 Logging Hook
fn demonstrateLoggingHook() void {
    std.debug.print("   // 创建 Logging Hook\n", .{});
    std.debug.print("   var logging = LoggingHook.init(\n", .{});
    std.debug.print("       .{{ .verbose = true, .slow_query_threshold_ms = 1000 }}\n", .{});
    std.debug.print("   );\n\n", .{});

    std.debug.print("   // 添加到 DB\n", .{});
    std.debug.print("   try db.addHook(logging.hook());\n\n", .{});

    std.debug.print("   // 执行查询时会自动记录:\n", .{});
    std.debug.print("   // [QUERY] SELECT * FROM users WHERE id = $1\n", .{});
    std.debug.print("   // [ARGS] [1]\n", .{});
    std.debug.print("   // [TIME] 15.3ms\n", .{});
}

/// 演示 Performance Hook
fn demonstratePerformanceHook() void {
    std.debug.print("   // 创建 Performance Hook\n", .{});
    std.debug.print("   var perf = PerformanceHook.init(\n", .{});
    std.debug.print("       .{{ .warn_threshold_ms = 100, .track_stats = true }}\n", .{});
    std.debug.print("   );\n\n", .{});

    std.debug.print("   // 添加到 DB\n", .{});
    std.debug.print("   try db.addHook(perf.hook());\n\n", .{});

    std.debug.print("   // 性能监控会记录:\n", .{});
    std.debug.print("   // - 查询执行时间\n", .{});
    std.debug.print("   // - 慢查询警告 (超过阈值)\n", .{});
    std.debug.print("   // - 查询统计信息\n\n", .{});

    std.debug.print("   // 获取统计信息\n", .{});
    std.debug.print("   const stats = perf.getStats();\n", .{});
    std.debug.print("   std.debug.print(\"总查询数: {{}}\\n\", .{{stats.total_queries}});\n", .{});
    std.debug.print("   std.debug.print(\"平均时间: {{}}ms\\n\", .{{stats.avg_duration_ms}});\n", .{});
}

/// 演示自定义统计钩子
fn demonstrateCustomHook(allocator: std.mem.Allocator) void {
    _ = allocator;

    std.debug.print("   // 自定义钩子: 查询统计\n", .{});
    std.debug.print("   const QueryStatsHook = struct {{\n", .{});
    std.debug.print("       select_count: usize = 0,\n", .{});
    std.debug.print("       insert_count: usize = 0,\n", .{});
    std.debug.print("       update_count: usize = 0,\n", .{});
    std.debug.print("       delete_count: usize = 0,\n\n", .{});

    std.debug.print("       pub fn hook(self: *@This()) QueryHook {{\n", .{});
    std.debug.print("           return QueryHook{{\n", .{});
    std.debug.print("               .beforeFn = beforeQuery,\n", .{});
    std.debug.print("               .afterFn = null,\n", .{});
    std.debug.print("               .context = self,\n", .{});
    std.debug.print("           }};\n", .{});
    std.debug.print("       }}\n\n", .{});

    std.debug.print("       fn beforeQuery(ctx: *anyopaque, sql: []const u8, args: []const QueryArg) !void {{\n", .{});
    std.debug.print("           const self = @ptrCast(*@This(), @alignCast(@alignOf(@This()), ctx));\n", .{});
    std.debug.print("           if (std.mem.startsWith(u8, sql, \"SELECT\")) {{\n", .{});
    std.debug.print("               self.select_count += 1;\n", .{});
    std.debug.print("           }} else if (std.mem.startsWith(u8, sql, \"INSERT\")) {{\n", .{});
    std.debug.print("               self.insert_count += 1;\n", .{});
    std.debug.print("           }} else if (std.mem.startsWith(u8, sql, \"UPDATE\")) {{\n", .{});
    std.debug.print("               self.update_count += 1;\n", .{});
    std.debug.print("           }} else if (std.mem.startsWith(u8, sql, \"DELETE\")) {{\n", .{});
    std.debug.print("               self.delete_count += 1;\n", .{});
    std.debug.print("           }}\n", .{});
    std.debug.print("       }}\n", .{});
    std.debug.print("   }};\n\n", .{});

    std.debug.print("   // 使用统计钩子\n", .{});
    std.debug.print("   var stats_hook = QueryStatsHook{{}};\n", .{});
    std.debug.print("   try db.addHook(stats_hook.hook());\n", .{});
}

/// 演示审计日志钩子
fn demonstrateAuditHook() void {
    std.debug.print("   // 自定义钩子: 审计日志 (记录所有修改操作)\n", .{});
    std.debug.print("   const AuditHook = struct {{\n", .{});
    std.debug.print("       allocator: std.mem.Allocator,\n", .{});
    std.debug.print("       audit_log: std.ArrayList(AuditEntry),\n\n", .{});

    std.debug.print("       const AuditEntry = struct {{\n", .{});
    std.debug.print("           timestamp: i64,\n", .{});
    std.debug.print("           operation: []const u8, // INSERT/UPDATE/DELETE\n", .{});
    std.debug.print("           sql: []const u8,\n", .{});
    std.debug.print("           user_id: ?i64,\n", .{});
    std.debug.print("       }};\n\n", .{});

    std.debug.print("       fn beforeQuery(ctx: *anyopaque, sql: []const u8, args: []const QueryArg) !void {{\n", .{});
    std.debug.print("           const self = @ptrCast(*@This(), @alignCast(@alignOf(@This()), ctx));\n\n", .{});

    std.debug.print("           // 只记录修改操作\n", .{});
    std.debug.print("           const is_mutation = std.mem.startsWith(u8, sql, \"INSERT\") or\n", .{});
    std.debug.print("                               std.mem.startsWith(u8, sql, \"UPDATE\") or\n", .{});
    std.debug.print("                               std.mem.startsWith(u8, sql, \"DELETE\");\n\n", .{});

    std.debug.print("           if (is_mutation) {{\n", .{});
    std.debug.print("               try self.audit_log.append(.{{\n", .{});
    std.debug.print("                   .timestamp = std.time.timestamp(),\n", .{});
    std.debug.print("                   .operation = detectOperation(sql),\n", .{});
    std.debug.print("                   .sql = sql,\n", .{});
    std.debug.print("                   .user_id = getCurrentUserId(),\n", .{});
    std.debug.print("               }});\n", .{});
    std.debug.print("           }}\n", .{});
    std.debug.print("       }}\n", .{});
    std.debug.print("   }};\n", .{});
}

/// 演示多个钩子组合
fn demonstrateMultipleHooks() void {
    std.debug.print("   // 同时使用多个钩子\n", .{});
    std.debug.print("   var logging = LoggingHook.init(.{{}});\n", .{});
    std.debug.print("   var perf = PerformanceHook.init(.{{}});\n", .{});
    std.debug.print("   var stats = QueryStatsHook{{}};\n\n", .{});

    std.debug.print("   // 按顺序添加钩子\n", .{});
    std.debug.print("   try db.addHook(logging.hook());     // 第一个执行\n", .{});
    std.debug.print("   try db.addHook(perf.hook());        // 第二个执行\n", .{});
    std.debug.print("   try db.addHook(stats.hook());       // 第三个执行\n\n", .{});

    std.debug.print("   // 执行查询时,钩子按添加顺序依次调用:\n", .{});
    std.debug.print("   // 1. logging.beforeQuery()  -> 记录查询日志\n", .{});
    std.debug.print("   // 2. perf.beforeQuery()     -> 开始计时\n", .{});
    std.debug.print("   // 3. stats.beforeQuery()    -> 更新统计\n", .{});
    std.debug.print("   // --- 执行查询 ---\n", .{});
    std.debug.print("   // 4. stats.afterQuery()     -> 更新统计\n", .{});
    std.debug.print("   // 5. perf.afterQuery()      -> 结束计时\n", .{});
    std.debug.print("   // 6. logging.afterQuery()   -> 记录结果\n\n", .{});

    std.debug.print("   // 清空所有钩子\n", .{});
    std.debug.print("   db.clearHooks();\n", .{});
}
